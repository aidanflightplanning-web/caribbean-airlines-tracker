# Copy this file to .streamlit/secrets.toml for local development, or
# paste values into Streamlit Community Cloud's Settings -> Secrets.
# Never commit the real secrets.toml — it's gitignored.
#
# Everything here is optional — the app works with none of it set.

# Flight numbers to always check via Caribbean Airlines' own status feed,
# regardless of whether any ADS-B source currently shows them airborne.
# No community ADS-B feed has perfect coverage, so a specific flight you
# care about can otherwise miss a refresh cycle (or, if it hasn't departed
# yet, never show up at all — ADS-B can't see a flight before it's in the
# air). Comma- or newline-separated flight numbers, no "BW" prefix.
# Keep this short: each entry adds a paced ~1.5s request every refresh.
WATCHLIST_FLIGHT_NUMBERS = "526,217,415"
