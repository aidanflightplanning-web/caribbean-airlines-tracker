# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml — it's gitignored.
#
# On Streamlit Community Cloud, paste these same keys/values into
# your app's Settings -> Secrets instead of committing a file.

# Required for schedule, delay, and status data (departure/arrival times,
# on-time/delayed/cancelled/diverted). Free tier: https://aviationstack.com
# is capped at 100 requests/month, so the app caches this data for 30 min.
AVIATIONSTACK_API_KEY = ""

# Optional. A free OpenSky Network account (https://opensky-network.org)
# raises your live-position API rate limit above the anonymous tier.
OPENSKY_USERNAME = ""
OPENSKY_PASSWORD = ""
